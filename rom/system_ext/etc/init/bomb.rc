# Bomb ROM backend — typed property triggers only.
#
# The app cannot write properties. It sends bounded commands to bombd; bombd
# owns only the Bomb request properties, while init owns every privileged
# service/sysfs operation. There is no shell command, arbitrary property or path.

# Mode 0666 is intentional: Android app UIDs do not share a Unix group, while
# SELinux restricts connectto/write to the exact bomb_app domain. bombd also
# verifies SO_PEERCRED and /proc/PID/cmdline before accepting a command.
service bombd /system_ext/bin/bombd
    class core
    user system
    group system
    socket bombd stream 0666 root root u:object_r:bombd_socket:s0
    restart_period 5

# Reconcile the persistent declared tier after Android has finished booting.
on property:sys.boot_completed=1 && property:persist.sys.bomb.log.level=reduced
    setprop persist.sys.bomb.log.request reduced

on property:sys.boot_completed=1 && property:persist.sys.bomb.log.level=off
    setprop persist.sys.bomb.log.request off

# DEFAULT: hand managed properties back to platform defaults and restart the
# services Bomb may have stopped. logd-reinit is required for buffer-size reset.
on property:persist.sys.bomb.log.request=default
    setprop persist.logd.kernel ""
    setprop persist.logd.statistics ""
    setprop persist.logd.size ""
    setprop persist.logd.limit ""
    setprop logd.logpersistd.enable ""
    setprop persist.traced.enable ""
    setprop persist.traced_perf.enable ""
    setprop persist.logd.audit.rate ""
    start logd
    start logd-reinit
    start traced
    start traced_probes
    start logcatd
    setprop persist.sys.bomb.log.level default
    setprop persist.sys.bomb.log.request idle

# REDUCED keeps logd and SELinux denials alive, but shrinks buffers and stops
# persistent log capture plus Perfetto daemons.
on property:persist.sys.bomb.log.request=reduced
    setprop persist.logd.kernel false
    setprop persist.logd.statistics false
    setprop persist.logd.size 64K
    setprop persist.logd.limit Off
    setprop logd.logpersistd.enable false
    setprop persist.traced.enable 0
    setprop persist.traced_perf.enable 0
    setprop persist.logd.audit.rate ${persist.sys.bomb.log.audit_rate:-5}
    stop logcatd
    stop traced
    stop traced_probes
    start logd-reinit
    setprop persist.sys.bomb.log.level reduced
    setprop persist.sys.bomb.log.request idle

# OFF is intentionally available in integrated ROM mode without Magisk,
# KernelSU, Shizuku or an adb/root session. The target image was verified to
# have no repeating logd restarter and logd is not critical. Keep this action
# disabled while bringing up SELinux policy, because stopping logd removes AVCs.
on property:persist.sys.bomb.log.request=off && property:persist.sys.bomb.selinux_bringup=0
    setprop persist.logd.kernel false
    setprop persist.logd.statistics false
    setprop persist.logd.size 64K
    setprop persist.logd.limit Off
    setprop logd.logpersistd.enable false
    setprop persist.traced.enable 0
    setprop persist.traced_perf.enable 0
    setprop persist.logd.audit.rate ${persist.sys.bomb.log.audit_rate:-5}
    stop logcatd
    stop traced
    stop traced_probes
    stop logd-auditctl
    setprop persist.sys.bomb.log.level off
    setprop persist.sys.bomb.log.request idle
    stop logd

# Fail closed if someone requests OFF while policy bring-up is active.
on property:persist.sys.bomb.log.request=off && property:persist.sys.bomb.selinux_bringup=1
    setprop persist.sys.bomb.log.request idle

# Live memory knobs. Values are range-validated by BombCoreService before they
# can reach these fixed paths. sys_critical is deliberately never written.
on property:persist.sys.bomb.memory.swappiness=*
    write /proc/sys/vm/swappiness ${persist.sys.bomb.memory.swappiness}
    write /dev/memcg/memory.swappiness ${persist.sys.bomb.memory.swappiness}
    write /dev/memcg/freeze-app/memory.swappiness ${persist.sys.bomb.memory.swappiness}
    write /dev/memcg/apps/memory.swappiness ${persist.sys.bomb.memory.swappiness}
    write /dev/memcg/system/memory.swappiness ${persist.sys.bomb.memory.swappiness}

on property:persist.sys.bomb.memory.page_cluster=*
    write /proc/sys/vm/page-cluster ${persist.sys.bomb.memory.page_cluster}

# Charge-current cap, in microamps. BombCoreService + PowerSupplyBackend
# range-validate the value and bombd publishes it as a bounded int; init owns the
# actual sysfs write here. Non-existent paths fail harmlessly (as with the memcg
# swappiness fan-out above). The fixed paths mirror the backend's supply/node
# allowlist; whichever node the capability probe selected is the one init writes.
# Restoring the stock cap uses this trigger with the captured original value.
on property:persist.sys.bomb.charge.current_max=*
    write /sys/class/power_supply/battery/constant_charge_current_max ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/bms/constant_charge_current_max ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/battery/input_current_limit ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/bms/input_current_limit ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/battery/current_max ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/bms/current_max ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/usb/input_current_limit ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/usb/current_max ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/ac/input_current_limit ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/ac/current_max ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/mains/input_current_limit ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/mains/current_max ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/wireless/input_current_limit ${persist.sys.bomb.charge.current_max}
    write /sys/class/power_supply/wireless/current_max ${persist.sys.bomb.charge.current_max}

# Capacity threshold and charging gates use the same bounded bombd -> property ->
# init path as the current cap. Fan-out is intentionally limited to fixed,
# allowlisted power-supply names; Bomb never accepts a caller-provided sysfs path.
on property:persist.sys.bomb.charge.end_threshold=*
    write /sys/class/power_supply/battery/charge_control_end_threshold ${persist.sys.bomb.charge.end_threshold}
    write /sys/class/power_supply/bms/charge_control_end_threshold ${persist.sys.bomb.charge.end_threshold}

on property:persist.sys.bomb.charge.disable=*
    write /sys/class/power_supply/battery/charge_disable ${persist.sys.bomb.charge.disable}
    write /sys/class/power_supply/bms/charge_disable ${persist.sys.bomb.charge.disable}

on property:persist.sys.bomb.charge.charging_enabled=*
    write /sys/class/power_supply/battery/charging_enabled ${persist.sys.bomb.charge.charging_enabled}
    write /sys/class/power_supply/bms/charging_enabled ${persist.sys.bomb.charge.charging_enabled}

on property:persist.sys.bomb.charge.input_suspend=*
    write /sys/class/power_supply/battery/input_suspend ${persist.sys.bomb.charge.input_suspend}
    write /sys/class/power_supply/bms/input_suspend ${persist.sys.bomb.charge.input_suspend}
    write /sys/class/power_supply/usb/input_suspend ${persist.sys.bomb.charge.input_suspend}
    write /sys/class/power_supply/ac/input_suspend ${persist.sys.bomb.charge.input_suspend}
    write /sys/class/power_supply/mains/input_suspend ${persist.sys.bomb.charge.input_suspend}
    write /sys/class/power_supply/wireless/input_suspend ${persist.sys.bomb.charge.input_suspend}


# CPU/GPU frequency limits use the same bounded bombd -> property -> init
# path as charge control. Fan-out is fixed and allowlisted (per-policy
# scaling nodes, policy0..policy7; GPU devfreq + kgsl legacy); Bomb never
# accepts a caller-provided sysfs path. Values are the raw node units the
# app read back and bombd range-checked: CPU in kHz, GPU in Hz. Non-existent
# paths fail harmlessly, as with the charge fan-out above.
on property:persist.sys.bomb.freq.cpu0_min=*
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq ${persist.sys.bomb.freq.cpu0_min}

on property:persist.sys.bomb.freq.cpu0_max=*
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq ${persist.sys.bomb.freq.cpu0_max}

on property:persist.sys.bomb.freq.cpu1_min=*
    write /sys/devices/system/cpu/cpufreq/policy1/scaling_min_freq ${persist.sys.bomb.freq.cpu1_min}

on property:persist.sys.bomb.freq.cpu1_max=*
    write /sys/devices/system/cpu/cpufreq/policy1/scaling_max_freq ${persist.sys.bomb.freq.cpu1_max}

on property:persist.sys.bomb.freq.cpu2_min=*
    write /sys/devices/system/cpu/cpufreq/policy2/scaling_min_freq ${persist.sys.bomb.freq.cpu2_min}

on property:persist.sys.bomb.freq.cpu2_max=*
    write /sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq ${persist.sys.bomb.freq.cpu2_max}

on property:persist.sys.bomb.freq.cpu3_min=*
    write /sys/devices/system/cpu/cpufreq/policy3/scaling_min_freq ${persist.sys.bomb.freq.cpu3_min}

on property:persist.sys.bomb.freq.cpu3_max=*
    write /sys/devices/system/cpu/cpufreq/policy3/scaling_max_freq ${persist.sys.bomb.freq.cpu3_max}

on property:persist.sys.bomb.freq.cpu4_min=*
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq ${persist.sys.bomb.freq.cpu4_min}

on property:persist.sys.bomb.freq.cpu4_max=*
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq ${persist.sys.bomb.freq.cpu4_max}

on property:persist.sys.bomb.freq.cpu5_min=*
    write /sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq ${persist.sys.bomb.freq.cpu5_min}

on property:persist.sys.bomb.freq.cpu5_max=*
    write /sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq ${persist.sys.bomb.freq.cpu5_max}

on property:persist.sys.bomb.freq.cpu6_min=*
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq ${persist.sys.bomb.freq.cpu6_min}

on property:persist.sys.bomb.freq.cpu6_max=*
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq ${persist.sys.bomb.freq.cpu6_max}

on property:persist.sys.bomb.freq.cpu7_min=*
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq ${persist.sys.bomb.freq.cpu7_min}

on property:persist.sys.bomb.freq.cpu7_max=*
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq ${persist.sys.bomb.freq.cpu7_max}

on property:persist.sys.bomb.freq.gpu_min=*
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq ${persist.sys.bomb.freq.gpu_min}
    write /sys/class/kgsl/kgsl-3d0/min_gpuclk ${persist.sys.bomb.freq.gpu_min}

on property:persist.sys.bomb.freq.gpu_max=*
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq ${persist.sys.bomb.freq.gpu_max}
    write /sys/class/kgsl/kgsl-3d0/max_gpuclk ${persist.sys.bomb.freq.gpu_max}

